<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_students_list" model="ir.ui.view">
        <field name="name">student.student.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_name" />
                <field name="student_id" />
                <field name="gender" />
                <field name="date_of_birth" />
                <field name="phone_no" />
                <field name="email" />
                <field name="address" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                                <field name="student_name" required="1" />
                                <field name="student_id" required="1" />
                                <field name="gender" required="1" />
                                <field name="phone_no" required="1"/>
                            </group>

                            <group>
                                <!-- readonly, invisible, required , string , default-->
                                <field name="email" required="1" />
                                <field name="date_of_birth" required="1" />
                                <field name="address" required="1"/>
                                <field name="active" required="1"/>
                            </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_students_list" model="ir.actions.act_window">
        <field name="name">Student Records</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>