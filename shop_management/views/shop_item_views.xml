<?xml version="1.0" encoding="UTF-8"?>
<!-- Shop items List view for the shop.item model -->
<odoo>
    <record id="view_shop_item_list" model="ir.ui.view">
        <field name="name">shop.item.list</field>
        <field name="model">shop.item</field>
        <field name="arch" type='xml'>
            <list>
                <field name="name" />
                <field name="number" />
                <field name="quantity" />
                <field name="is_available" />
                <field name="date" />
            </list>
        </field>
    </record>

    <!-- Shop items Form View for the shop.item model -->
    <record id="view_shop_item_form" model="ir.ui.view">
        <field name="name">shop.item.form</field>
        <field name="model">shop.item</field>
        <field name="arch" type='xml'>
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_sold" string="Sold" type="object" class="btn-primary" invisible="state != 'available'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,sold" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Item Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="name" required="1" /> -->
                            <field name="number" required="1" />
                            <field name="quantity" />
                            <field name="currency_id" />
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>

                        <group>
                            <!-- readonly, invisible, required , string , default-->
                            <field name="is_available" />
                            <field name="date" />
                            <field name="received_datetime" />
                            <field name="state" invisible="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="tag-lines">
<!--                            Must add the id of one2many attritbute-->
                            <field name="item_line_ids">
                                <list editable ='bottom'>
                                    <field name="product_id"/>
                                    <field name="quantity" />
                                    <field name="unit_cost" />
                                    <field name="total_amount" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_item" model="ir.actions.act_window">
        <field name="name">Items Tags</field>
        <field name="res_model">shop.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_shop_item_tag_list" model="ir.ui.view">
        <field name="name">shop.item.tag.list</field>
        <field name="model">shop.item.tag</field>
        <field name="arch" type='xml'>
            <list>
                <field name="name" />
                <field name="color" />
            </list>
        </field>
    </record>

        <record id="view_shop_item_tag_form" model="ir.ui.view">
        <field name="name">shop.item.tag.form</field>
        <field name="model">shop.item.tag</field>
        <field name="arch" type='xml'>
            <form>
                <sheet>
                    <group>
                        <group>
                           <field name="name"/>
                            <field name="color" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_item_tag" model="ir.actions.act_window">
        <field name="name">Items Tags</field>
        <field name="res_model">shop.item.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>